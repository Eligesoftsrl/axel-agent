# Copia questo file in .env e compila i valori

# Obbligatoria: chiave da https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
DEFAULT_MODEL=claude-sonnet-5-5

# Telegram (notifiche + chat dal telefono): token da @BotFather
TELEGRAM_BOT_TOKEN=

# Fuso orario per promemoria e briefing
TZ_NAME=Europe/Rome

# Porte locali (cambiale solo se modifichi anche vite.config.ts)
PORT=8010
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Spotify (opzionale): app da https://developer.spotify.com/dashboard
# Redirect URI da registrare: http://127.0.0.1:8010/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Philips Hue (opzionale): di solito trovato da solo; altrimenti l'IP del Bridge (app Hue → Bridge → info)
HUE_BRIDGE_IP=

# Velocità (opzionale): modello usato per le richieste brevi
FAST_MODEL=claude-haiku-4-5-20251001

# Voce locale Whisper (opzionale, vedi README "Voce locale"): motore e modello
WHISPER_ENGINE=
WHISPER_MODEL=

# Mappe con traffico reale (opzionale): chiave Google con Routes API + Geocoding API
GOOGLE_MAPS_API_KEY=

# Voce maschile di AXEL con Google Cloud Text-to-Speech (opzionale, vedi README "Voce maschile")
GOOGLE_TTS_API_KEY=

# Voce delle risposte vocali su Telegram (opzionale, elenco: say -v '?')
MAC_VOICE=

# Code execution e programmatic tool calling (1 = attivi, 0 = spenti)
ANTHROPIC_CODE_EXECUTION=1
